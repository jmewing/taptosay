<?xml version="1.0" encoding="utf-8"?>
<!-- Paths the FileProvider may share with the system installer. The self-updater
     writes the downloaded APK to <cacheDir>/updates/, so a cache-path is enough. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="updates" path="updates/" />
</paths>
